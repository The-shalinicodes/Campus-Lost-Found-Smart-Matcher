import '@servicenow/sdk/global'
import { StateModel, BusinessRule } from '@servicenow/sdk/core'

// =============================================================================
// LOST ITEM STATE MODEL
// States: new -> searching -> matched -> claimed -> closed | expired
// =============================================================================
StateModel({
    $id: Now.ID['lost_item_state_model'],
    name: 'Lost Item Lifecycle',
    table: 'x_1927922_campus_l_lost_item',
    stateField: 'state',
    states: {
        new: {
            $id: Now.ID['lost_state_new'],
            label: 'New',
            value: 'new',
            sequence: 0,
            initial: true,
        },
        searching: {
            $id: Now.ID['lost_state_searching'],
            label: 'Searching',
            value: 'searching',
            sequence: 1,
        },
        matched: {
            $id: Now.ID['lost_state_matched'],
            label: 'Matched',
            value: 'matched',
            sequence: 2,
        },
        claimed: {
            $id: Now.ID['lost_state_claimed'],
            label: 'Claimed',
            value: 'claimed',
            sequence: 3,
        },
        closed: {
            $id: Now.ID['lost_state_closed'],
            label: 'Closed',
            value: 'closed',
            sequence: 4,
        },
        expired: {
            $id: Now.ID['lost_state_expired'],
            label: 'Expired',
            value: 'expired',
            sequence: 5,
        },
    },
    transitions: [
        { $id: Now.ID['lost_new_to_searching'], from: 'new', to: 'searching' },
        { $id: Now.ID['lost_new_to_closed'], from: 'new', to: 'closed' },
        { $id: Now.ID['lost_new_to_expired'], from: 'new', to: 'expired' },
        { $id: Now.ID['lost_searching_to_matched'], from: 'searching', to: 'matched' },
        { $id: Now.ID['lost_searching_to_closed'], from: 'searching', to: 'closed' },
        { $id: Now.ID['lost_searching_to_expired'], from: 'searching', to: 'expired' },
        { $id: Now.ID['lost_matched_to_claimed'], from: 'matched', to: 'claimed' },
        { $id: Now.ID['lost_matched_to_closed'], from: 'matched', to: 'closed' },
        { $id: Now.ID['lost_claimed_to_closed'], from: 'claimed', to: 'closed' },
    ],
})

