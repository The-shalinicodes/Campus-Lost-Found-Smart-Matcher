// =============================================================================
// STATE MODEL ASSIGNMENT BUSINESS RULES
// Assign the appropriate state model to new records on insert
// =============================================================================

BusinessRule({
    $id: Now.ID['assign_lost_item_model'],
    name: 'Assign Lost Item State Model',
    table: 'x_1927922_campus_l_lost_item',
    when: 'before',
    action: ['insert'],
    filterCondition: 'modelISEMPTY',
    script: `(function executeRule(current, previous) {
    var modelGr = new GlideRecord('sttrm_model');
    modelGr.addQuery('table_name', current.getTableName());
    modelGr.addActiveQuery();
    modelGr.orderBy('order');
    modelGr.setLimit(1);
    modelGr.query();
    if (modelGr.next()) {
        current.setValue('model', modelGr.getUniqueValue());
    }
})(current, previous);`,
})

BusinessRule({
    $id: Now.ID['assign_found_item_model'],
    name: 'Assign Found Item State Model',
