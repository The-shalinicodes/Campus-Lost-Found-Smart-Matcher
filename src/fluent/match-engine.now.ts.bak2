import '@servicenow/sdk/global'
import { ScriptInclude, BusinessRule } from '@servicenow/sdk/core'

ScriptInclude({
    $id: Now.ID['MatchEngine'],
    name: 'MatchEngine',
    script: Now.include('../server/script-includes/match-engine.js'),
    description: 'Smart matching engine for Campus Lost and Found. Computes confidence scores between lost and found items using category, location, timeline, and description similarity. Creates match records for pairs exceeding 40 percent confidence.',
    accessibleFrom: 'package_private',
    active: true,
})

BusinessRule({
    $id: Now.ID['trigger_match_lost_item'],
    name: 'Trigger Match on New Lost Item',
    table: 'x_1927922_campus_l_lost_item',
    when: 'async',
    action: ['insert'],
    filterCondition: 'state=new',
    priority: 200,
    description: 'When a new lost item is created with state new, run the MatchEngine to find matching found items in cataloged state.',
    script: Now.include('../server/business-rules/trigger-match-lost-item.js'),
})

BusinessRule({
    $id: Now.ID['trigger_match_found_item'],
    name: 'Trigger Match on Cataloged Found Item',
    table: 'x_1927922_campus_l_found_item',
    when: 'async',
    action: ['insert', 'update'],
    filterCondition: 'state=cataloged',
    priority: 200,
    description: 'When a found item enters cataloged state, run the MatchEngine to find matching lost items in new or searching state.',
    script: Now.include('../server/business-rules/trigger-match-found-item.js'),
})

BusinessRule({
    $id: Now.ID['generate_claim_code'],
    name: 'Generate Claim Code on Match',
    table: 'x_1927922_campus_l_match',
    when: 'before',
    action: ['insert'],
    order: 200,
    description: 'Auto-generate a unique 8-character alphanumeric claim code for every new match record using MatchEngine.generateClaimCode().',
    script: Now.include('../server/business-rules/generate-claim-code.js'),
})

BusinessRule({
    $id: Now.ID['update_states_match_confirmed'],
    name: 'Update States on Match Confirmed',
    table: 'x_1927922_campus_l_match',
    when: 'after',
    action: ['update'],
    filterCondition: 'stateVALCHANGES^state=confirmed',
    order: 200,
    description: 'When a match is confirmed, update the associated lost item and found item states to matched.',
    script: Now.include('../server/business-rules/update-states-match-confirmed.js'),
})

BusinessRule({
    $id: Now.ID['update_states_claim_pickup'],
    name: 'Update States on Claim Pickup',
    table: 'x_1927922_campus_l_claim',
    when: 'after',
    action: ['update'],
    filterCondition: 'stateVALCHANGES^state=picked_up',
    order: 200,
    description: 'When a claim is picked up, update match to confirmed, lost item to claimed, found item to claimed, and close any other pending matches.',
    script: Now.include('../server/business-rules/update-states-claim-pickup.js'),
})
